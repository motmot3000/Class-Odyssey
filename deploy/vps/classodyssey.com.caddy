# Adresse canonique : https://classodyssey.com/
#
# Service direct : classodyssey.com est le seul hôte indexable (le serveur
# envoie `X-Robots-Tag: noindex` à tout autre hôte, cf. server/static.mjs).
# Une redirection vers le relais www.thomaswunsche.com/classodyssey rendait
# donc tout le site non indexable par Google.
#
# Le réseau de l'État de Genève, qui classe classodyssey.com « Newly Registered
# Domain » (art. 16a LIP), garde l'accès par classodyssey.thomaswunsche.com et
# par le relais www.thomaswunsche.com/classodyssey (autres vhosts).
#
# Le conteneur ne publie que 127.0.0.1:5180, donc ce vhost est le point
# d'entrée public. `security_headers` est le snippet de security-headers.caddy.
www.classodyssey.com {
	import security_headers
	redir https://classodyssey.com{uri} permanent
}

classodyssey.com {
	import security_headers
	header Strict-Transport-Security "max-age=31536000"
	encode zstd gzip

	# Game state is per-user and must never be cached by an intermediary.
	@api path /api/*
	header @api Cache-Control "no-store"

	reverse_proxy 127.0.0.1:5180

	log {
		format json
	}
}
