      "html": "<button class=\"ds-character\" type=\"button\" aria-pressed=\"true\"><span class=\"ds-avatar\">N</span><span><strong>Noa</strong><small>Version garçon</small></span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m5 12 4 4 10-10\"/></svg></button>",
      "css": ".ds-character{display:flex;align-items:center;gap:9px;padding:11px 10px;border:1px solid var(--line,#d9e0d4);border-radius:8px;background:var(--paper,#fafbf6);color:var(--ink,#273e35);text-align:left;font:400 14px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,'Segoe UI',sans-serif;cursor:pointer}.ds-character[aria-pressed=true]{background:var(--selected,#e4ecdE);border-color:#9caf91}.ds-character:hover{border-color:#8da680}.ds-character:focus-visible{outline:2px solid #39815a;outline-offset:4px}.ds-character:disabled{opacity:.46;cursor:wait}.ds-character strong{display:block;font-size:13px;font-weight:600}.ds-character small{display:block;margin-top:1px;font-size:10px;color:var(--muted,#65736a)}.ds-avatar{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;flex:none;background:#ded7c8;color:#6c5338;font-size:14px;font-weight:600}.ds-character svg{width:14px;height:14px;margin-left:auto;color:#537443;visibility:hidden;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;flex:none}.ds-character[aria-pressed=true] svg{visibility:visible}@media(max-width:1100px){.ds-character{gap:7px;padding:10px 8px}.ds-avatar{width:28px;height:28px}}@media(max-width:760px){.ds-character{gap:8px;padding:12px 10px}.ds-character strong{font-size:14px}.ds-character small{font-size:11px;white-space:nowrap}.ds-avatar{width:31px;height:31px}.ds-character svg{width:12px;height:12px}}"
    },
