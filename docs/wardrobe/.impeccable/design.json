      "css": ".ds-outfit{width:100%;display:flex;align-items:center;gap:12px;padding:10px 12px;border:1px solid var(--line,#d9e0d4);border-radius:8px;background:var(--paper,#fafbf6);color:var(--ink,#273e35);text-align:left;font:400 14px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,'Segoe UI',sans-serif;cursor:pointer}.ds-outfit[aria-pressed=true]{background:var(--selected,#e4ecdE);border-color:#9caf91}.ds-outfit:hover{border-color:#8da680}.ds-outfit:focus-visible{outline:2px solid #39815a;outline-offset:4px}.ds-outfit:disabled{opacity:.46;cursor:wait}.ds-outfit strong{display:block;font-size:12px;font-weight:600}.ds-outfit small{display:block;color:var(--muted,#65736a);font-size:10px;margin-top:3px}.ds-garment{width:40px;height:40px;border-radius:7px;display:grid;place-items:center;flex:none;color:#2f706e;background:#dceae4}.ds-garment svg{width:32px;height:32px;fill:currentColor;fill-opacity:.25;stroke:currentColor;stroke-width:1.15;stroke-linecap:round;stroke-linejoin:round}.ds-choice-dot{width:13px;height:13px;border:1px solid #bdcab3;border-radius:50%;margin-left:auto;flex:none}.ds-outfit[aria-pressed=true] .ds-choice-dot{border:4px solid #60844e;background:#f8fbf3}@media(max-width:760px){.ds-outfit{padding:12px}.ds-outfit strong{font-size:13px}.ds-outfit small{font-size:11px}.ds-garment{width:43px;height:43px}}"
