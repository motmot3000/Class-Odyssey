# Copier vers .env.console (ignoré par Git). Utiliser la même clé sur le VPS.
ADMIN_CONSOLE_KEY=remplacer-par-une-cle-aleatoire-de-32-caracteres-minimum
CONSOLE_API_URL=http://127.0.0.1:5180
CONSOLE_HOST=127.0.0.1
CONSOLE_PORT=5191
