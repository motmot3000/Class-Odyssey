# Identifiants du compte administrateur créé au premier démarrage local.
# Copier ce fichier vers .env et renseigner le mot de passe avant de lancer.
FOUNDER_USERNAME=local-admin
FOUNDER_PASSWORD=

# Écoute locale. Chaque worktree peut choisir son propre PORT ; Go Live en
# attribue un libre si celui-ci est déjà occupé.
HOST=127.0.0.1
PORT=5180

# Facultatif (production). MAX_ACCOUNTS plafonne les inscriptions ; TRUST_PROXY=1
# fait confiance à X-Forwarded-For quand un reverse proxy (Caddy) est devant.
# MAX_ACCOUNTS=500
# MAX_BACKUPS=60
# TRUST_PROXY=1
