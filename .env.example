# Identifiants du compte administrateur créé au premier démarrage local.
# Copier ce fichier vers .env et renseigner le mot de passe avant de lancer.
FOUNDER_USERNAME=local-admin
FOUNDER_PASSWORD=

# Écoute locale. Chaque worktree peut choisir son propre PORT ; Go Live en
# attribue un libre si celui-ci est déjà occupé.
HOST=127.0.0.1
PORT=5180

# Facultatif (production). TRUST_PROXY=1 fait confiance à X-Forwarded-For quand
# un reverse proxy (Caddy) est devant, pour une limitation de débit par visiteur.
# MAX_BACKUPS=60
# TRUST_PROXY=1

# Facultatif. Connexion Google : renseigner les deux valeurs pour afficher le
# bouton « Continuer avec Google ». GOOGLE_REDIRECT_URI n'est utile que si le
# proxy ne transmet pas le bon hôte ; sinon l'URL est déduite de la requête.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://exemple.fr/api/auth/google/callback
