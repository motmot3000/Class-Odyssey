# Copy to .env. Choose your own founder password before the first start.
# These credentials initialize an administrator; they do not reset one.
FOUNDER_USERNAME=local-admin
FOUNDER_PASSWORD=

HOST=127.0.0.1
PORT=5180

# Optional storage. Each development checkout should have independent data.
# DATA_DIR=/absolute/path/to/local-data
# MAX_BACKUPS=60

# Enable only behind a trusted proxy that replaces X-Forwarded-For.
# TRUST_PROXY=1

# Optional Google OAuth: both values are required to show the sign-in button.
# Callback defaults to the request origin/prefix plus /api/auth/google/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your-domain.example/api/auth/google/callback

# Optional password-reset email (Resend, with a verified sender).
# Without transport, reset codes are logged ONLY outside production.
# RESEND_API_KEY=
# MAIL_FROM="Class Odyssey <no-reply@your-domain.example>"

# Optional operator console. Generate a random key of at least 32 characters;
# share it with .env.console, never with browser code or Git.
# ADMIN_CONSOLE_KEY=

# Optional local GeoLite2 City database (mount it in Docker if used).
# GEOIP_DB=/absolute/path/to/GeoLite2-City.mmdb

# Production containers set this automatically. Suppresses reset-code logging.
# NODE_ENV=production
